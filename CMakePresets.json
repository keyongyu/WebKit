{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": {
                    "type": "STRING",
                    "value": "Release"
                }
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": {
                    "type": "STRING",
                    "value": "Debug"
                }
            }
        },
        {
            "name": "dev",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "DEVELOPER_MODE": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "ENABLE_EXPERIMENTAL_FEATURES": {
                    "type": "BOOL",
                    "value": "ON"
                }
            }
        },
        {
            "name": "gtk",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "PORT": {
                    "type": "STRING",
                    "value": "GTK"
                }
            }
        },
        {
            "name": "gtk-release",
            "hidden": true,
            "displayName": "GTK Release",
            "inherits": ["gtk", "release"],
            "binaryDir": "WebKitBuild/GTK/Release"
        },
        {
            "name": "gtk-debug",
            "hidden": true,
            "displayName": "GTK Debug",
            "inherits": ["gtk", "debug"],
            "binaryDir": "WebKitBuild/GTK/Debug"
        },
        {
            "name": "gtk-dev-release",
            "hidden": true,
            "displayName": "GTK Development Release",
            "inherits": ["gtk-release", "dev"]
        },
        {
            "name": "gtk-dev-debug",
            "hidden": true,
            "displayName": "GTK Development Debug",
            "inherits": ["gtk-debug", "dev"]
        },
        {
            "name": "wpe",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "PORT": {
                    "type": "STRING",
                    "value": "WPE"
                }
            }
        },
        {
            "name": "wpe-release",
            "hidden": true,
            "displayName": "WPE Release",
            "inherits": ["wpe", "release"],
            "binaryDir": "WebKitBuild/WPE/Release"
        },
        {
            "name": "wpe-debug",
            "hidden": true,
            "displayName": "WPE Debug",
            "inherits": ["wpe", "debug"],
            "binaryDir": "WebKitBuild/WPE/Debug"
        },
        {
            "name": "wpe-dev-release",
            "hidden": true,
            "displayName": "WPE Development Release",
            "inherits": ["wpe-release", "dev"]
        },
        {
            "name": "wpe-dev-debug",
            "hidden": true,
            "displayName": "WPE Development Debug",
            "inherits": ["wpe-debug", "dev"]
        },
        {
            "name": "jsc",
            "hidden": true,
            "generator": "Ninja",
            "environment": {
                "CC": "clang-cl",
                "CXX": "clang-cl",
                "PATH": "C:\\Ruby32-x64\\bin;C:\\Program Files (x86)\\GnuWin32\\bin;C:\\Program Files\\LLVM\\bin;C:\\Program Files\\CMake\\bin;c:\\xampp\\perl\\bin;c:\\xampp\\apache\\bin"
            },
            "cacheVariables": {
                "PORT": {
                    "type": "STRING",
                    "value": "JSCOnly"
                },
                "USE_INSPECTOR_SOCKET_SERVER": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "ENABLE_REMOTE_INSPECTOR": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "ENABLE_JIT": {
                    "type": "BOOL",
                    "value": "OFF"
                },
                "ENABLE_STATIC_JSC": {
                    "type": "BOOL",
                    "value": "ON"
                }
            }
        },
        {
            "name": "jsc-debug",
            "displayName": "jsc Debug",
            "inherits": [ "jsc", "debug" ],
            "binaryDir": "WebKitBuild/jsc/Debug"
        },
        {
            "name": "jsc-release",
            "displayName": "jsc release",
            "inherits": [ "jsc", "release" ],
            "binaryDir": "WebKitBuild/jsc/Release"
        }
    ]
  
}
